<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE golem SYSTEM "xml-golemHierro.dtd">

<golem origen="aldea">
    <tipo>Defensor de la aldea</tipo>

    <comportamiento>

        <patrullaje>
            <velocidad>Lenta</velocidad>
            <zona>Alrededor de los edificios de la aldea</zona>
            <limite>No se aleja de la aldea mientras exista</limite>
            <ciclo>
                <tipoCiclo>Infinito</tipoCiclo>
            </ciclo>
        </patrullaje>

        <proteccion>
            <objetivoPrincipal>Aldeanos</objetivoPrincipal>
            <objetivoSecundario>Aldea</objetivoSecundario>
        </proteccion>

        <interaccion>
            <aldeanos>
                <accionAldeano>Les ofrece amapolas como señal de amistad</accionAldeano>
            </aldeanos>
        </interaccion>

        <restricciones>
            <ataque>
                <puedeAtacar>Criaturas hostiles</puedeAtacar>
                <noAtaca>Creepers</noAtaca>
            </ataque>

            <movimiento>
                <desplazamiento>Permanece dentro de la aldea y patrulla constantemente</desplazamiento>
                <obstaculos>Puede subir bloques de una altura sin saltar y cruzar huecos pequeños</obstaculos>
            </movimiento>

            <entorno>
                <agua>Evita el agua, pero si entra se hunde y deja de moverse</agua>
                <lava>Evita la lava</lava>
                <fuego>No evita el fuego</fuego>
                <caidas>No recibe daño por caídas</caidas>
            </entorno>
        </restricciones>

        <reacciones>

            <condicion prioridad="alta">
                <si>Hay una criatura hostil cerca</si>
                <entonces>
                    <accion>
                        <tipoAccion>Atacar</tipoAccion>
                        <objetivoAccion tipo="hostil">Enemigo cercano</objetivoAccion>
                    </accion>
                </entonces>
            </condicion>

            <condicion prioridad="alta">
                <si>Un jugador ataca a un aldeano dentro de su alcance</si>
                <entonces>
                    <accion>
                        <tipoAccion>Atacar</tipoAccion>
                        <objetivoAccion tipo="jugador">Jugador agresor</objetivoAccion>
                    </accion>
                </entonces>
            </condicion>

            <condicion prioridad="alta">
                <si>Un jugador ataca al propio golem</si>
                <entonces>
                    <accion>
                        <tipoAccion>Atacar</tipoAccion>
                        <objetivoAccion tipo="jugador">Jugador agresor</objetivoAccion>
                    </accion>
                </entonces>
            </condicion>

            <condicion prioridad="media">
                <si>Un aldeano está en peligro</si>
                <entonces>
                    <accion>
                        <tipoAccion>Defender</tipoAccion>
                        <objetivoAccion tipo="aldeano">Aldeano</objetivoAccion>
                    </accion>
                </entonces>
            </condicion>

            <condicion prioridad="baja">
                <si>No hay amenazas</si>
                <entonces>
                    <accion>
                        <tipoAccion>Patrullar</tipoAccion>
                        <objetivoAccion tipo="aldea">Aldea</objetivoAccion>
                    </accion>
                </entonces>
            </condicion>

        </reacciones>

    </comportamiento>
</golem>